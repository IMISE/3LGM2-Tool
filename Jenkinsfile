pipeline {	agent any		tools {		jdk "JDK-8"		maven "Maven-3.6.3"	}		stages {		stage('AXSUTILS') {			steps {			    script {			        echo 'Get Library'			        sh 'curl -O http://svn.apache.org/repos/asf/servicemix/m2-repo/com/bea/xml/jsr173-ri/1.0/jsr173-ri-1.0.jar'                    echo 'install jar'                    sh 'mvn install:install-file -DgeneratePom=true'			        echo 'install mvn'			        sh 'mvn -B -U clean install'			    }			}		}	}}