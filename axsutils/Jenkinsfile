pipeline {	agent {docker {image: 'maven: 3.6.3'} }		tools {		jdk "jdk-1.8"	}		stages {		stage('AXSUTILS') {			steps {			    step('Get Library') {			        sh 'curl -O http://svn.apache.org/repos/asf/servicemix/m2-repo/com/bea/xml/jsr173-ri/1.0/jsr173-ri-1.0.jar'			    }                step('Install Library') {                    mvn install:install-file -DgeneratePom=true			    }			    step('Build') {			        sh 'mvn -B clean install'			    }			}		}	}}