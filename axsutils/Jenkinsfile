pipeline {	agent {docker {image: 'maven: 3.6.3'} }		tools {		jdk "jdk-1.8"	}		stages {		stage('AXSUTILS') {			steps {			    step('Get Library') {			        >&2 echo 'Get Library'			        sh 'curl -O http://svn.apache.org/repos/asf/servicemix/m2-repo/com/bea/xml/jsr173-ri/1.0/jsr173-ri-1.0.jar'			    }			    step('Create POM') {			        sh 'echo "<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd\">\n                                 <groupId>com.bea.xml</groupId>\n                                 <artifactId>jsr173-ri</artifactId>\n                                 <version>1.0</version>\n                             </project>" > jsr173.pom'                    >&2 echo 'create POM'                }                step('Install POM') {                    mvn install:install-file -Dfile=jsr173-ri-1.0.jar -DpomFile=jsr173.pom                    >&2 echo 'install POM'			    }			    step('Install') {			        sh 'mvn -B clean install'			        >&2 echo 'install mvn'			    }			}		}	}}