	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
	</properties>
	<build>
		<finalName>tool3lgm</finalName>
		<plugins>
			<!-- http://maven.apache.org/shared/maven-archiver/index.html -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>true</addClasspath>
							<mainClass>de.imise.tool3lgm.Tool3lgmMain</mainClass>
						</manifest>
						<manifestEntries>
							<!-- <Class-Path>here can only named jars placed or directories containing 
								.class-files but not directories containing jar files</Class-Path> -->
							<!-- geht alles nicht wie es soll :( -->
							<!-- <Class-Path>./Plugins/tool3lgm.metamodel.original-1.0.0.jar ./Plugins/tool3lgm.metamodel.service-1.0.0.jar 
								./Plugins/tool3lgm.template.ihe-1.0.0.jar</Class-Path> -->
							<SplashScreen-Image>splash.gif</SplashScreen-Image>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>2.5</version>
				<configuration>
					<!-- Plugins-Verzeichnis im Deploy-Projekt leeren -->
					<filesets>
						<fileset>
							<directory>../de.imise.tool3lgm.deploy/Tool3lgm/Plugins</directory>
							<includes>
								<include>**/*</include>
							</includes>
							<followSymlinks>false</followSymlinks>
						</fileset>
						<!-- Plugins-Verzeichnis im Eclipse-Development-Projekt leeren -->
						<fileset>
							<directory>../de.imise.tool3lgm/Plugins/</directory>
							<includes>
								<include>**/*</include>
							</includes>
							<followSymlinks>false</followSymlinks>
						</fileset>
						<!-- lib-Verzeichnis im Deploy-Projekt leeren -->
						<fileset>
							<directory>../de.imise.tool3lgm.deploy/Tool3lgm/lib</directory>
							<includes>
								<include>**/*</include>
							</includes>
							<followSymlinks>false</followSymlinks>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
			<!-- lib-Verzeichnis im Deploy-Projekt wieder füllen -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.1.1</version>
				<executions>
					<!-- alle Dependencies ins lib-Verzeichnis im Deploy-Projekt kopieren -->
					<execution>
						<id>copy-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>../de.imise.tool3lgm.deploy/Tool3lgm/lib</outputDirectory>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>false</overWriteSnapshots>
							<overWriteIfNewer>true</overWriteIfNewer>
							<includeScope>compile</includeScope>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- per Ant die tool3lgm.jar aus dem target ins deploy kopieren -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>1.8</version>
				<executions>
					<execution>
						<phase>package</phase>
						<configuration>
							<target>
								<copy
									file="${project.build.directory}/${project.artifactId}.${project.packaging}"
									tofile="../de.imise.tool3lgm.deploy/Tool3lgm/lib/${project.artifactId}.${project.packaging}" />
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- <plugin> -->
			<!-- <groupId>org.codehaus.mojo</groupId> -->
			<!-- <artifactId>license-maven-plugin</artifactId> -->
			<!-- <version>1.20</version> -->
			<!-- <executions> -->
