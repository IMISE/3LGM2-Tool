        <status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trial Implementation</status>
        <ontology:abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPD</ontology:abbreviation>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Healthcare Provider Directory</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD_PROV_INFO_CONS -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD_PROV_INFO_CONS">
        <rdf:type rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <iheIntegrationProfile rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD"/>
        <iti-58 rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD_PROV_INFO_DIR"/>
        <integrationProfile_dataProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPD</integrationProfile_dataProperty>
        <ontology:abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PROV_INFO_CONS</ontology:abbreviation>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provider Information Consumer (HPD)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD_PROV_INFO_DIR -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD_PROV_INFO_DIR">
        <rdf:type rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <iheIntegrationProfile rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD"/>
        <integrationProfile_dataProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPD</integrationProfile_dataProperty>
        <ontology:abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PROV_INFO_DIR</ontology:abbreviation>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provider Information Directory (HPD)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD_PROV_INFO_SRC -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD_PROV_INFO_SRC">
        <rdf:type rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <iheIntegrationProfile rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD"/>
        <iti-59 rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD_PROV_INFO_DIR"/>
        <iti-69 rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD_PROV_INFO_DIR"/>
        <integrationProfile_dataProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPD</integrationProfile_dataProperty>
        <ontology:abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PROV_INFO_SRC</ontology:abbreviation>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provider Information Source (HPD)</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#HPD_PROV_INFO_SRC"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-69"/>
