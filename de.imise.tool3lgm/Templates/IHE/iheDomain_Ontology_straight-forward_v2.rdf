        <rad-55 rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#XDS-IB_IMG_DOC_SOURCE"/>
        <rad-69 rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#XDS-IB_IMG_DOC_SOURCE"/>
        <integrationProfile_dataProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">XDS-I.b</integrationProfile_dataProperty>
