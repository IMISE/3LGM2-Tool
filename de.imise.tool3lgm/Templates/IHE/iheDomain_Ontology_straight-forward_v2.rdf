    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#3lgm-classname-edge -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#3lgm-classname-edge"/>
    


    <!-- https://w3id.org/saref4ee#optionalSlot -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/saref4ee#optionalSlot"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
