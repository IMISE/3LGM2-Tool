     -->

    


    <!-- http://schema.org/url -->

    <rdfs:Datatype rdf:about="http://schema.org/url"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheDomain -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheDomain">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#IntegrationProfile"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Domain"/>
        <rdfs:label xml:lang="en">IHE Domain</rdfs:label>
        <rdfs:seeAlso xml:lang="en">isPublishedIn</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheIntegrationProfile -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheIntegrationProfile">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#IntegrationProfile"/>
        <rdfs:label xml:lang="en">IHE Integration Profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#usesActor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <rdfs:comment xml:lang="en">Convention: Only &quot;invoking&quot; is modeled! The &quot;reacting&quot; counterpart could be derived, later.</rdfs:comment>
        <rdfs:label xml:lang="en">Transaction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#invokes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#invokes">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#toDo"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <rdfs:label>ITI Transactions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-1 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-1">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-1</ontology:abbreviation>
        <terms:description>NTP transactions used to maintain time synchronization.</terms:description>
        <rdfs:label>Maintain Time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-10 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-10">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-10</ontology:abbreviation>
        <terms:description>Allows a Patient Identity Consumer to be notified by the Patient Identity Cross-reference Manager Actor of changes to the identification of a patient in Patient Identification Domains the Consumer is interested in.</terms:description>
        <rdfs:label>PIX Update Notification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-11 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-11">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-11</ontology:abbreviation>
        <terms:description>A request issued by a display system for specific information related to a patient returned in a ready for presentation information format</terms:description>
        <rdfs:label>Retrieve Specific Information for Display</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-12 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-12">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-12</ontology:abbreviation>
        <terms:description>A display system requests an instance of a uniquely identified persistent document under custodianship by an information source and returns its content ready for presentation.</terms:description>
        <rdfs:label>Retrieve Document for Display</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-13 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-13">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-13</ontology:abbreviation>
        <terms:description>Accounts for all messages required to propagate a context change to a responding participant actor: -Survey of all other Context Participant Actors by the Context Manager Actor and display by the instigating Participant Actor of any associated replies. -Notification of context change result from the Context manager Actor to the Context Participant Actors. -Retrieval of the context data by the Context Participant Actors</terms:description>
        <rdfs:label>Follow Context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-18 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-18">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-18</ontology:abbreviation>
        <terms:description>The Query Registry transaction is issued by the Document Consumer Actor on behalf of a care provider (EHR-CR) to a Document Registry. The Document Registry Actor searches the registry to locate documents that meet the provider s specified query criteria. It will return a list of document entries that contain metadata found to meet the specified criteria including the locations and identifier of each corresponding document in one or more Document Repositories. The stored query uses parameters and not direct SQL</terms:description>
        <rdfs:label>Registry Stored Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-19 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-19">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-19</ontology:abbreviation>
        <terms:description>This transaction is embedded within all network communications activity. All DICOM, HL7, and HTML connections shall comply with the IHE specification for bi-directional authentication and authorization of communications of Protected Healthcare Information (PHI). IHE does not specify how other protocols that transfer PHI shall perform bi-directional authentication and authorization, but requires that other protocols perform such authentication and authorization.</terms:description>
        <rdfs:label>Authenticate Node</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-2 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-2">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-2</ontology:abbreviation>
        <terms:description>The Client Authentication Agent requests user authentication from the Kerberos Authentication Server.  When the user is authenticated, the Kerberos Authentication Server returns a Ticket Granting Ticket (TGT) to optimize future activity.</terms:description>
        <rdfs:label>Get User Authentication</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-20 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-20">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-20</ontology:abbreviation>
        <terms:description>The delivery of an audit event description from any secure node to the Audit Repository.</terms:description>
        <rdfs:label>Record Audit Event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-21 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-21">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-21</ontology:abbreviation>
        <terms:description>Look up and return patient demographic information in a single patient demographics source, based upon matches with full or partial demographic information entered by the user.</terms:description>
        <rdfs:label>Patient Demographics Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-22 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-22">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-22</ontology:abbreviation>
        <terms:description>Look up and return patient demographic and visit information in a single patient demographics source, based upon matches with full or partial demographic/visit information entered by the user.</terms:description>
        <rdfs:label>Patient Demographics and Visit Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-23 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-23">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-23</ontology:abbreviation>
        <terms:description>This transaction will find the LDAP Directory by querying the DNS.</terms:description>
        <rdfs:label>Find Personnel White Pages</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-24 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-24">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-24</ontology:abbreviation>
        <terms:description>This transaction provides for read-only access to the Personnel White Pages directory.</terms:description>
        <rdfs:label>Query Personnel White Pages</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-3 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-3">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-3</ontology:abbreviation>
        <terms:description>Obtain a ticket using Kerberos protocol for use with a service. Service identity option is specific for each protocol. For example HOST for HTTP.</terms:description>
        <rdfs:label>Get Service Ticket</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-30 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-30">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-30</ontology:abbreviation>
        <terms:description>The Patient Demographics Supplier registers or updates a patient and forwards the demographic information (i.e. all information directly related to the patient, such as ID, address, next of kin, to other systems implementing Patient Demographics Consumer.</terms:description>
        <rdfs:label>Patient Identity Management</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-31 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-31">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-31</ontology:abbreviation>
        <terms:description>The Patient Encounter Source registers or updates an encounter (inpatient, outpatient, pre-admit...) and forwards the information to other systems implementing Patient Encounter Consumer. This information will include the patients location and care providers for a particular (usually current) encounter.</terms:description>
        <rdfs:label>Patient Encounter Management</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-32 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-32">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-32</ontology:abbreviation>
        <terms:description>The Portable Media Creator sends information to media reading actors by means of Interchange Media where it stores the information.</terms:description>
        <rdfs:label>Distribute Document Set on Media</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-34 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-34">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-34</ontology:abbreviation>
        <terms:description>Retrieve Form</terms:description>
        <rdfs:label>Retrieve Form</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-35 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-35">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-35</ontology:abbreviation>
        <terms:description>Submit Form</terms:description>
        <rdfs:label>Submit Form</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-36 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-36">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-36</ontology:abbreviation>
        <terms:description>Archive Form</terms:description>
        <rdfs:label>Archive Form</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-37 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-37">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-37</ontology:abbreviation>
        <terms:description>Retrieve Clarifications</terms:description>
        <rdfs:label>Retrieve Clarifications</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-38 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-38">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-38</ontology:abbreviation>
        <terms:description>Cross Gateway Query</terms:description>
        <rdfs:label>Cross Gateway Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-39 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-39">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-39</ontology:abbreviation>
        <terms:description>Cross Gateway Retrieve</terms:description>
        <rdfs:label>Cross Gateway Retrieve</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-4 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-4">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-4</ontology:abbreviation>
        <terms:description>The Kerberized Communication transaction is an aspect of the connection between a local client and a remote server.</terms:description>
        <rdfs:label>Kerberized Communication</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-40 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-40">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-40</ontology:abbreviation>
        <terms:description>Provide X-User Assertion</terms:description>
        <rdfs:label>Provide X-User Assertion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-41 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-41">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-41</ontology:abbreviation>
        <terms:description>Provide and Register Document Set-b</terms:description>
        <rdfs:label>Provide and Register Document Set-b</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-42 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-42">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-42</ontology:abbreviation>
        <terms:description>Register Document Set-b</terms:description>
        <rdfs:label>Register Document Set-b</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-43 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-43">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-43</ontology:abbreviation>
        <terms:description>Retrieve Document Set</terms:description>
        <rdfs:label>Retrieve Document Set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-44 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-44">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-44</ontology:abbreviation>
        <terms:description>Patient Identity Feed HL7 V3</terms:description>
        <rdfs:label>Patient Identity Feed HL7 V3</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-45 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-45">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-45</ontology:abbreviation>
        <terms:description>PIXV3 Query</terms:description>
        <rdfs:label>PIXV3 Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-46 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-46">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-46</ontology:abbreviation>
        <terms:description>PIXV3 Update Notification</terms:description>
        <rdfs:label>PIXV3 Update Notification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-47 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-47">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-47</ontology:abbreviation>
        <terms:description>Patient Demographics Query HL7 V3</terms:description>
        <rdfs:label>Patient Demographics Query HL7 V3</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-48 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-48">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-48</ontology:abbreviation>
        <terms:description>This transaction is used by the Value Set Consumer to retrieve a Resolved Value Set from the Value Set Repository.  The Value Set Consumer has previously obtained the Resolved Value Set OID by means outside of the scope of this transaction. Appendix B of the IHE ITI Technical Framework Volume 2 has further information about obtaining and managing OIDs which are used as the Value Set Unique ID.</terms:description>
        <rdfs:label>Retrieve Value Set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-5 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-5">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-5</ontology:abbreviation>
        <terms:description>Allows a Context Participant Actor to locate and establish communication with the Context Manager Actor.</terms:description>
        <rdfs:label>Join Context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-51 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-51">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-51</ontology:abbreviation>
        <terms:description>Multi-Patient Stored Query</terms:description>
        <rdfs:label>Multi-Patient Stored Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-52 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-52">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-52</ontology:abbreviation>
        <terms:description>Document Metadata Subscribe</terms:description>
        <rdfs:label>Document Metadata Subscribe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-53 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-53">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-53</ontology:abbreviation>
        <terms:description>Document Metadata Notify</terms:description>
        <rdfs:label>Document Metadata Notify</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-54 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-54">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-54</ontology:abbreviation>
        <terms:description>Document Metadata Publish</terms:description>
        <rdfs:label>Document Metadata Publish</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-55 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-55">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-55</ontology:abbreviation>
        <terms:description>Cross Gateway Patient Discovery</terms:description>
        <rdfs:label>Cross Gateway Patient Discovery</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-56 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-56">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-56</ontology:abbreviation>
        <terms:description>Patient Location Query</terms:description>
        <rdfs:label>Patient Location Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-57 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-57">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-57</ontology:abbreviation>
        <terms:description>The Update Document Set transaction passes a collection of metadata updates from the Document Administrator actor to the Document Registry or Document Recipient actor.</terms:description>
        <rdfs:label>Update Document Set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-58 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-58">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-58</ontology:abbreviation>
        <terms:description>This transaction supports the ability to lookup information about healthcare providers from a healthcare provider directory on the following: • Individual Providers – A person who provides healthcare services, such as a physician, nurse, or pharmacist. • Organizational Providers – Organizations that provide or support healthcare services, such as hospitals, Healthcare Information Exchanges (HIEs), Managed Care, Integrated Delivery Networks (IDNs), and Associations. • Relationship between providers.</terms:description>
        <rdfs:label>Provider Information Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-59 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-59">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-59</ontology:abbreviation>
        <terms:description>The Provider Information Feed specifies one or more of the following actions: • An “Add” to add new provider entries • A “Delete” to delete any existing provider entries • An “Update” to modify or update any existing provider entries</terms:description>
        <rdfs:label>Provider Information Feed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-6 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-6">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-6</ontology:abbreviation>
        <terms:description>Includes all messages required to initiate and finalize a context change transaction: -Initiation of a context change request from the instigating participant actor. -Delivery of survey results to instigating actor and display of associated replies. -Communication of context change decision to the Context Manager Actor</terms:description>
        <rdfs:label>Change Context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-60 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-60">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-60</ontology:abbreviation>
        <terms:description>The Value Set Consumer retrieves multiple value sets from the Value Set Repository.  These retrieved value sets have metadata that matches retrieval selection criteria.  The retrieved sets provide the full metadata describing the value set, and an expanded value set representation for that value set.</terms:description>
        <rdfs:label>Retrieve Multiple Value Sets</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-61 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-61">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-61</ontology:abbreviation>
        <terms:description>The Register On-Demand Document Entry transaction is used by the On-Demand Document Source to register one or more On-Demand Document Entries in the Document Registry.</terms:description>
        <rdfs:label>Register On-Demand Document Entry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-63 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-63">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-63</ontology:abbreviation>
        <terms:description>This transaction is used to fetch a document or a set of documents from a remote community that matches a given set of metadata attribute values.</terms:description>
        <rdfs:label>Cross Gateway Fetch</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-69 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-69">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-69</ontology:abbreviation>
        <terms:description>Create Destroy Pull Point</terms:description>
        <rdfs:label>Create Destroy Pull Point</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-7 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-7">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-7</ontology:abbreviation>
        <terms:description>Allows Context Participant Actor to notify the Context manager Actor that it is breaking off communication.</terms:description>
        <rdfs:label>Leave Context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-70 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-70">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-70</ontology:abbreviation>
        <terms:description>Pull Notification</terms:description>
        <rdfs:label>Pull Notification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-78 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-78">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-78</ontology:abbreviation>
        <terms:description>Performs a query against a patient demographics supplier using HTTP, REST, and JSON/XML message encoding.</terms:description>
        <rdfs:label>Mobile Patient Demographics Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-79 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-79">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-79</ontology:abbreviation>
        <terms:description>Transaction used by the service provider (Authorization Decisions Verifier) to request valid authorization decisions granted for the Requester Entity to disclose specific documents.</terms:description>
        <rdfs:label>Authorization Decisions Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-8 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-8">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-8</ontology:abbreviation>
        <terms:description>Allows a Patient Identity Source Actor to notify a Patient Identity Cross-Referencing Actor of all events related to patient identification (creation, update, merge, etc.).</terms:description>
        <rdfs:label>Patient Identity Feed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-81 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-81">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-81</ontology:abbreviation>
        <terms:description>Retrieve Audit Messages. Search ATNA audit messages based upon queries using ATNA audit message content.</terms:description>
        <rdfs:label>Retrieve ATNA Audit Event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-82 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-82">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-82</ontology:abbreviation>
        <terms:description>Retrieve Syslog Messages. Search syslog messages based upon using the syslog metadata.</terms:description>
        <rdfs:label>Retrieve Syslog Event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-83 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-83">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-83</ontology:abbreviation>
        <terms:description>Performs a query against a patient identifier cross-reference manager using HTTP, REST, and JSON/XML message encoding.</terms:description>
        <rdfs:label>Mobile Patient Identifier Cross-Reference Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-9 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-9">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti"/>
        <ontology:abbreviation>ITI-9</ontology:abbreviation>
        <terms:description>This transaction allows a Patient Identity Consumer to find out the identification of a patient in different Patient Identification Domains by using the services of a Patient Identity Cross-reference Manager Actor.</terms:description>
        <rdfs:label>PIX Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <rdfs:label>LAB Transactions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab-1 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab-1">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab"/>
        <ontology:abbreviation>LAB-1</ontology:abbreviation>
        <terms:description>This transaction contains all the messages required between the Order Placer and the Order Filler for the management of the life cycle of the order. Its main goal is to keep a consistent vision of the order, (content and status), between the two actors.</terms:description>
        <rdfs:label>Lab Placer Order Management</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab-2 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab-2">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab"/>
        <ontology:abbreviation>LAB-2</ontology:abbreviation>
        <terms:description>This transaction contains all the messages required between the Order Filler and the Order Placer for the notification of a new filler order, as well as the creation of the placer order that reflects it. Its main goal is to ensure that each filler order will be represented by a placer order, and will have both a filler order number and a placer order number.</terms:description>
        <rdfs:label>Lab Filler Order Management</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab-3 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab-3">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab"/>
        <ontology:abbreviation>LAB-3</ontology:abbreviation>
        <terms:description>This transaction carries changes of the observation results and order status from Order Filler to Order Result Tracker i.e. corrections, cancellations.</terms:description>
        <rdfs:label>Order Results Management</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab-4 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab-4">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab"/>
        <ontology:abbreviation>LAB-4</ontology:abbreviation>
        <terms:description>This transaction contain all the messages required between Order Filler and Automation Manager for the execution of a work order containing a subset of tests of the filler order. The main goal of this transaction is to distribute the work to the Automation Manager, and to keep this actor informed of all patient and order updates. This transaction will be based on a push mechanism, the query mechanism never being used in this transaction.</terms:description>
        <rdfs:label>Work Order Management</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab-5 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab-5">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#lab"/>
        <ontology:abbreviation>LAB-5</ontology:abbreviation>
        <terms:description>This transaction carries the technically validated test results from the Automation Manager to the Order Filler.</terms:description>
        <rdfs:label>Test Result Management</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#mustBeGroupedWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#mustBeGroupedWith">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#usesActor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <rdfs:comment xml:lang="en">Convention: Only &quot;must be grouped with&quot; is modeled! The &quot;is required for grouping of&quot; counterpart could be derived, later.</rdfs:comment>
        <rdfs:label xml:lang="en">must be grouped with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#provides -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#provides">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#toDo"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#provides_mandatory -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#provides_mandatory">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#provides_optional"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#provides_optional -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#provides_optional">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#toDo"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <rdfs:label>RAD Transactions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-16 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-16">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad"/>
        <ontology:abbreviation>RAD-16</ontology:abbreviation>
        <terms:description>An Image Display or an Imaging Document Consumer requests and retrieves a particular image or set of images from the Image Archive or an Imaging Document Source, respectively.</terms:description>
        <rdfs:label>Retrieves Images</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-17 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-17">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad"/>
        <ontology:abbreviation>RAD-17</ontology:abbreviation>
        <terms:description>An Image Display or an Imaging Document Consumer requests and retrieves the Grayscale Softcopy Presentation State (GSPS) information for a particular image or image set.</terms:description>
        <rdfs:label>Retrieve Presentation States</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-27 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-27">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad"/>
        <ontology:abbreviation>RAD-27</ontology:abbreviation>
        <terms:description>A Report Reader or an Imaging Document Consumer requests and retrieves a diagnostic report from the Report Repository, External Report Repository Access or an Imaging Document Source.</terms:description>
        <rdfs:label>Retrieve Reports</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-31 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-31">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad"/>
        <ontology:abbreviation>RAD-31</ontology:abbreviation>
        <terms:description>An Image Display or an Imaging Document Consumer requests and retrieves a Key Image Note from the Image Archive or an Imaging Document Source, respectively.</terms:description>
        <rdfs:label>Retrieve Key Image Note</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-45 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-45">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad"/>
        <ontology:abbreviation>RAD-45</ontology:abbreviation>
        <terms:description>A user of Evidence Documents (Image Display, Report Creator or Report Reader) or an Imaging Document Consumer requests and retrieves an Evidence Document from the Image Archive or an Imaging Document Source, respectively.</terms:description>
        <rdfs:label>Retrieve Evidence Documents</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-55 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-55">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad"/>
        <ontology:abbreviation>RAD-55</ontology:abbreviation>
        <terms:description>A WADO Retrieve transaction is issued by an Imaging Document Consumer to an Imaging Document Source to retrieve DICOM objects over HTTP/HTTPS protocol [RAD-55].</terms:description>
        <rdfs:label>WADO Retrieve</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-68 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-68">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad"/>
        <ontology:abbreviation>RAD-68</ontology:abbreviation>
        <terms:description>Provide and Register Imaging Doc Set-MTOM/XOP</terms:description>
        <rdfs:label>Provide and Register Imaging Doc Set-MTOM/XOP</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-69 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad-69">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#rad"/>
        <ontology:abbreviation>RAD-69</ontology:abbreviation>
        <terms:description>Retrieve Imaging Doc Set</terms:description>
        <rdfs:label>Retrieve Imaging Doc Set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#toDo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#toDo"/>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#usesActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#usesActor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#IHEConcept"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
    </owl:ObjectProperty>
    


