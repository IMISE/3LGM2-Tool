     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:lgm2ihe="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#"
     xmlns:lgm2ihe1="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#3"
     xmlns:ontology="http://dbpedia.org/ontology/"
     xmlns:saref4ee="https://w3id.org/saref4ee#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe"/>
    


