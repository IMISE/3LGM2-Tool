        <integrationProfile_dataProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">XUA</integrationProfile_dataProperty>
        <ontology:abbreviation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-SERVICE-PROVIDER</ontology:abbreviation>
        <terms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-Service Provider</terms:description>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-Service Provider (XUA)</rdfs:label>
    </owl:NamedIndividual>
    


