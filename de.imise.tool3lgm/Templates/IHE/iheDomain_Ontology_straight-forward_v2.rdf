        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#IHEConcept"/>
        <rdfs:label xml:lang="en">Content Module</rdfs:label>
    </owl:Class>
    


