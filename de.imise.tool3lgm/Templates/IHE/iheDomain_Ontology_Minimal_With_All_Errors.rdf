    <!-- https://www.3lgm2.de/resource/ihe/status -->

    <owl:DatatypeProperty rdf:about="https://www.3lgm2.de/resource/ihe/status">
        <rdfs:subPropertyOf rdf:resource="https://www.3lgm2.de/resource/ihe/Group_Actor"/>
        <rdfs:subPropertyOf rdf:resource="https://www.3lgm2.de/resource/ihe/Group_IntegrationProfile"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.3lgm2.de/resource/ihe/Actor"/>
                    <rdf:Description rdf:about="https://www.3lgm2.de/resource/ihe/IntegrationProfile"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>Deprecated</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Final Text</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>Trial Implementation</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">Status</rdfs:label>
    </owl:DatatypeProperty>
    


