        <ontology:abbreviation>ITI-37</ontology:abbreviation>
        <terms:description>Retrieve Clarifications</terms:description>
        <rdfs:label>Retrieve Clarifications</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.3lgm2.de/resource/ihe/iti-43 -->

    <owl:ObjectProperty rdf:about="https://www.3lgm2.de/resource/ihe/iti-43">
        <rdfs:subPropertyOf rdf:resource="https://www.3lgm2.de/resource/ihe/iti"/>
        <ontology:abbreviation>ITI-43</ontology:abbreviation>
        <terms:description>Retrieve Document Set</terms:description>
        <rdfs:label>Retrieve Document Set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.3lgm2.de/resource/ihe/iti-62 -->

    <owl:ObjectProperty rdf:about="https://www.3lgm2.de/resource/ihe/iti-62">
        <rdfs:subPropertyOf rdf:resource="https://www.3lgm2.de/resource/ihe/iti"/>
        <ontology:abbreviation>ITI-62</ontology:abbreviation>
        <terms:description>The Remove Metadata transaction is used by the Document Administrator to request removal of one or more metadata objects from a Document Registry.</terms:description>
        <rdfs:label>Remove Metadata</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.3lgm2.de/resource/ihe/mustBeGroupedWith -->

    <owl:ObjectProperty rdf:about="https://www.3lgm2.de/resource/ihe/mustBeGroupedWith">
        <rdfs:subPropertyOf rdf:resource="https://www.3lgm2.de/resource/ihe/usesActor"/>
        <rdfs:domain rdf:resource="https://www.3lgm2.de/resource/ihe/Actor"/>
        <rdfs:range rdf:resource="https://www.3lgm2.de/resource/ihe/Actor"/>
        <rdfs:comment xml:lang="en">Convention: Only &quot;must be grouped with&quot; is modeled! The &quot;is required for grouping of&quot; counterpart could be derived, later.</rdfs:comment>
        <rdfs:label xml:lang="en">must be grouped with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.3lgm2.de/resource/ihe/rad -->

    <owl:ObjectProperty rdf:about="https://www.3lgm2.de/resource/ihe/rad">
