    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#integrationProfile_dataProperty -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#integrationProfile_dataProperty">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#helper"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#status -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#status">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#IntegrationProfile"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>Deprecated</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Final Text</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>Trial Implementation</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">Status</rdfs:label>
    </owl:DatatypeProperty>
    


