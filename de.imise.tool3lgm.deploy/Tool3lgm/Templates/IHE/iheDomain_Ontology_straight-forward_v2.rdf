        <rdfs:label xml:lang="en">Actor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#ContentModule -->

    <owl:Class rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#ContentModule">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#IHEConcept"/>
        <rdfs:label xml:lang="en">Content Module</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Domain -->

    <owl:Class rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Domain">
