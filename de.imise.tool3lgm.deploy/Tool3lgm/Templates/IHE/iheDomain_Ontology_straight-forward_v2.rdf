        <rdfs:range rdf:resource="http://schema.org/url"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#helper -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#helper"/>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheDomain_dataProperty -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheDomain_dataProperty">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#helper"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#IntegrationProfile"/>
