        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#IntegrationProfile"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Domain"/>
        <rdfs:label xml:lang="en">IHE Domain</rdfs:label>
        <rdfs:seeAlso xml:lang="en">isPublishedIn</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheIntegrationProfile -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheIntegrationProfile">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#IntegrationProfile"/>
        <rdfs:label xml:lang="en">IHE Integration Profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
        <rdfs:comment xml:lang="en">Convention: Only &quot;invoking&quot; is modeled! The &quot;reacting&quot; counterpart could be derived, later.</rdfs:comment>
        <rdfs:label xml:lang="en">Transaction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#invokes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#invokes">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#toDo"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#Actor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-10 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-10">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <ontology:abbreviation>ITI-10</ontology:abbreviation>
        <terms:description>Allows a Patient Identity Consumer to be notified by the Patient Identity Cross-reference Manager Actor of changes to the identification of a patient in Patient Identification Domains the Consumer is interested in.</terms:description>
        <rdfs:label>PIX Update Notification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-18 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-18">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <ontology:abbreviation>ITI-18</ontology:abbreviation>
        <terms:description>The Query Registry transaction is issued by the Document Consumer Actor on behalf of a care provider (EHR-CR) to a Document Registry. The Document Registry Actor searches the registry to locate documents that meet the provider s specified query criteria. It will return a list of document entries that contain metadata found to meet the specified criteria including the locations and identifier of each corresponding document in one or more Document Repositories. The stored query uses parameters and not direct SQL</terms:description>
        <rdfs:label>Registry Stored Query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-30 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-30">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <ontology:abbreviation>ITI-30</ontology:abbreviation>
        <terms:description>The Patient Demographics Supplier registers or updates a patient and forwards the demographic information (i.e. all information directly related to the patient, such as ID, address, next of kin, to other systems implementing Patient Demographics Consumer.</terms:description>
        <rdfs:label>Patient Identity Management</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-41 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-41">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <ontology:abbreviation>ITI-41</ontology:abbreviation>
        <terms:description>Provide and Register Document Set-b</terms:description>
        <rdfs:label>Provide and Register Document Set-b</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-42 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-42">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <ontology:abbreviation>ITI-42</ontology:abbreviation>
        <terms:description>Register Document Set-b</terms:description>
        <rdfs:label>Register Document Set-b</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-43 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-43">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <ontology:abbreviation>ITI-43</ontology:abbreviation>
        <terms:description>Retrieve Document Set</terms:description>
        <rdfs:label>Retrieve Document Set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-44 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-44">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <ontology:abbreviation>ITI-44</ontology:abbreviation>
        <terms:description>Patient Identity Feed HL7 V3</terms:description>
        <rdfs:label>Patient Identity Feed HL7 V3</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-57 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-57">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <ontology:abbreviation>ITI-57</ontology:abbreviation>
        <terms:description>The Update Document Set transaction passes a collection of metadata updates from the Document Administrator actor to the Document Registry or Document Recipient actor.</terms:description>
        <rdfs:label>Update Document Set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-61 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-61">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <ontology:abbreviation>ITI-61</ontology:abbreviation>
        <terms:description>The Register On-Demand Document Entry transaction is used by the On-Demand Document Source to register one or more On-Demand Document Entries in the Document Registry.</terms:description>
        <rdfs:label>Register On-Demand Document Entry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-8 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-8">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <ontology:abbreviation>ITI-8</ontology:abbreviation>
        <terms:description>Allows a Patient Identity Source Actor to notify a Patient Identity Cross-Referencing Actor of all events related to patient identification (creation, update, merge, etc.).</terms:description>
        <rdfs:label>Patient Identity Feed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-9 -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iti-9">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sippe/ontologies/2017/1/3lgm2ihe#iheTransaction"/>
        <ontology:abbreviation>ITI-9</ontology:abbreviation>
        <terms:description>This transaction allows a Patient Identity Consumer to find out the identification of a patient in different Patient Identification Domains by using the services of a Patient Identity Cross-reference Manager Actor. </terms:description>
        <rdfs:label>PIX Query</rdfs:label>
    </owl:ObjectProperty>
    


