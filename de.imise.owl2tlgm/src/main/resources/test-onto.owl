Prefix(:=<http://www.semanticweb.org/lippold/ontologies/2019/4/untitled-ontology-12#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://www.semanticweb.org/lippold/ontologies/2019/4/untitled-ontology-12>

Declaration(Class(:Buch))
Declaration(Class(:Regal))
Declaration(Class(:Sachbuch))
Declaration(ObjectProperty(:stehtInRegal))
Declaration(NamedIndividual(:buch1))
Declaration(NamedIndividual(:regal1))
############################
#   Object Properties
############################

# Object Property: :stehtInRegal (:stehtInRegal)

ObjectPropertyDomain(:stehtInRegal :Buch)
ObjectPropertyRange(:stehtInRegal :Regal)


############################
#   Classes
############################

# Class: :Sachbuch (:Sachbuch)

SubClassOf(:Sachbuch :Buch)


############################
#   Named Individuals
############################

# Individual: :buch1 (:buch1)

ClassAssertion(:Buch :buch1)

# Individual: :regal1 (:regal1)

ClassAssertion(:Regal :regal1)


)