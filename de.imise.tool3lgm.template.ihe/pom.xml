<!-- 					<target>1.8</target> -->
<!-- 				</configuration> -->
<!-- 			</plugin> -->
<!-- 		</plugins> -->
<!-- 		</pluginManagement> -->
	</build>


	<name>tool3lgm.template.ihe</name>
</project>
